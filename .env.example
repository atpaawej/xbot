# ==============================================================================
# xbot Configuration File
# Copy this file to .env.local (or .env) and update with your credentials.
# Note: .env.local takes precedence over .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration (OpenAI-Compatible)
# ------------------------------------------------------------------------------
# Supports any OpenAI-compatible completions API endpoint.
# Examples:
#   OpenAI:       https://api.openai.com/v1
#   OpenRouter:   https://openrouter.ai/api/v1
#   Groq:         https://api.groq.com/openai/v1
#   DeepSeek:     https://api.deepseek.com/v1
#   Together AI:  https://api.together.xyz/v1
#   Local Ollama: http://localhost:11434/v1
#   Local vLLM:   http://localhost:8000/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Your API Key for the LLM Provider
OPENAI_API_KEY=your_openai_or_compatible_api_key_here

# Model Identifier to use
# Examples:
#   gpt-4o, gpt-4o-mini, o3-mini
#   deepseek-chat, deepseek-reasoner
#   claude-3-5-sonnet, llama-3.3-70b-versatile
MODEL_ID=gpt-4o

# ------------------------------------------------------------------------------
# 2. TinyFish Web Intelligence (web_search & web_fetch)
# ------------------------------------------------------------------------------
# Powers live web search and smart webpage reading for the agent.
# Get your free API key at: https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=your_tinyfish_api_key_here

# ------------------------------------------------------------------------------
# 3. Execution & Environment Settings (Optional)
# ------------------------------------------------------------------------------
# Working directory for agent file operations & bash commands (default: .)
WORKSPACE_DIR=.

# Temperature for sampling (default: 0.0 for deterministic agent execution)
TEMPERATURE=0.0

# Timeout in seconds for bash tool execution (default: 120)
BASH_TIMEOUT=120
